# Native runs do NOT auto-load this file; Compose does.

# --- Required ---
CONTROL_TOKEN=replace-with-a-random-token-at-least-24-characters
METRICS_TOKEN=replace-with-another-random-token-at-least-24-characters

# --- Venue ---
# Unset means Binance Spot Demo Mode (virtual funds).
# Create demo keys at https://demo.binance.com/en/my/settings/api-management.
# Live: https://api.binance.com (real funds).
BINANCE_BASE_URL=
# Orders are never sent unless this is true, on either venue.
ENABLE_TRADING=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Live keys must be IP-restricted, reading + spot-trading only: no withdrawals,
# internal/universal transfers, margin, futures, or options permissions.

# --- Pairs ---
# Comma-separated USDT/USDC spot pairs. Each pair has its own cash, position, stop,
# and daily-loss baseline. Max 8.
TRADING_PAIRS=BTCUSDT,BTCUSDC,ETHUSDT,ETHUSDC

# --- Ollaya ---
OLLAYA_URL=http://127.0.0.1:11435
OLLAYA_API_KEY=
OLLAYA_MODEL=winnow:e4b
# Signal/ATR timeframe: 1m or 5m, independent of model request cadence.
SIGNAL_INTERVAL=1m
# One model request globally per interval, rotating pairs, never overlapping.
DECISION_INTERVAL_SECONDS=30
OLLAYA_TIMEOUT_SECONDS=20
# pullback: technical setup plus model approval; ollaya: model-led entry/exit.
ENTRY_POLICY=ollaya
REENTRY_COOLDOWN_SECONDS=10

# --- Server ---
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=data/trader.sqlite
# Set DATABASE_URL to use PostgreSQL; leave unset for SQLite.
DATABASE_URL=
# Legacy databases are not silently adopted. After verifying their original
# venue/account, attest once with demo:<Binance UID> or live:<Binance UID>.
# A known mismatch requires a separate database.
# Never use this to override a known venue/account mismatch.
STATE_BINDING_CONFIRM=
# Batched audit pruning; execution state/native-stop intents are never pruned.
AUDIT_RETENTION_DAYS=30
AUDIT_MAX_EVENTS=100000
# Compose only: generated hex password avoids DSN quoting issues.
POSTGRES_PASSWORD=replace-with-generated-hex-password
# Shared GHCR image for bot and exporter. Pin sha-<full commit SHA> or a digest
# instead of latest when deploying a specific tested version.
TRADER_IMAGE=ghcr.io/tsunderechen/trading_bot:latest
BOT_BIND_IP=127.0.0.1
EXPORTER_BIND_IP=127.0.0.1
BOT_PORT=8080
EXPORTER_PORT=9091
EXPORTER_ADDR=127.0.0.1:9091
BOT_URL=http://127.0.0.1:8080

# --- Risk (per pair, in that pair's USDT or USDC quote currency) ---
# Budget is an accounting allocation, not an automatic deposit or order size.
PER_PAIR_BUDGET=4000
MAX_POSITION_QUOTE=20
RISK_PER_TRADE_QUOTE=0.1
DAILY_LOSS_LIMIT_QUOTE=400
