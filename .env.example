# Copy settings into your service environment. The application does NOT auto-load .env.
CONTROL_TOKEN=replace-with-a-random-token-at-least-24-characters
METRICS_TOKEN=replace-with-another-random-token-at-least-24-characters
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=data/trader.sqlite
# Optional for native execution; if unset SQLite remains the default.
DATABASE_URL=
# Compose uses PostgreSQL. Use a generated hex password to avoid DSN quoting issues.
POSTGRES_PASSWORD=replace-with-generated-hex-password
BOT_BIND_IP=127.0.0.1
EXPORTER_BIND_IP=127.0.0.1
BOT_PORT=8080
EXPORTER_PORT=9091
EXPORTER_ADDR=127.0.0.1:9091
BOT_URL=http://127.0.0.1:8080
TRADING_PAIR=BTCUSDT
OLLAYA_URL=http://127.0.0.1:11435
OLLAYA_API_KEY=
# Default is observe-only. Use ONLY Binance Spot Testnet credentials.
ENABLE_TESTNET_TRADING=false
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
PAPER_BUDGET=1000
MAX_POSITION_QUOTE=100
RISK_PER_TRADE_QUOTE=2.5
DAILY_LOSS_LIMIT_QUOTE=10
