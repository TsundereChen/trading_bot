{
  "__inputs": [{"name":"DS_PROMETHEUS","label":"Prometheus","type":"datasource","pluginId":"prometheus","pluginName":"Prometheus"}],
  "title":"Automated Trader — Trading Performance",
  "uid":"automated-trader-testnet",
  "schemaVersion":39,
  "version":2,
  "refresh":"5s",
  "time":{"from":"now-1h","to":"now"},
  "tags":["trading","demo","performance"],
  "panels":[
    {"id":1,"title":"Net P&L after accounted fees","description":"Since tracking began. Existing positions retain cost basis; historical wins/losses are not invented. NaN means an unavailable valuation.","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_net_pnl_quote{job=\"automated-trader\"}","legendFormat":"{{pair}} ({{quote_asset}})"}]},
    {"id":2,"title":"Realized / unrealized P&L","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_realized_pnl_quote{job=\"automated-trader\"}","legendFormat":"{{pair}} realized ({{quote_asset}})"},{"refId":"B","expr":"trader_unrealized_pnl_quote{job=\"automated-trader\"}","legendFormat":"{{pair}} unrealized ({{quote_asset}})"}]},
    {"id":3,"title":"Completed trades / win rate","description":"Only fully observed cycles with valued fees. Win rate is N/A until a complete tracked cycle closes; counts survive restart.","type":"table","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_completed_trades{job=\"automated-trader\"}","instant":true,"format":"table"},{"refId":"B","expr":"trader_trade_win_rate{job=\"automated-trader\"}","instant":true,"format":"table"},{"refId":"C","expr":"trader_excluded_legacy_trades{job=\"automated-trader\"}","instant":true,"format":"table"}]},
    {"id":4,"title":"Fees paid (quote estimate)","description":"Quote commissions plus estimated base/third-asset value, since tracking began. Already accounted in P&L; do not subtract again.","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_fees_paid_quote_estimate{job=\"automated-trader\"}","legendFormat":"{{pair}} ({{quote_asset}})"}]},
    {"id":5,"title":"Average net win / loss","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":16,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_average_win_quote{job=\"automated-trader\"}","legendFormat":"{{pair}} win ({{quote_asset}})"},{"refId":"B","expr":"trader_average_loss_quote{job=\"automated-trader\"}","legendFormat":"{{pair}} loss ({{quote_asset}})"}]},
    {"id":6,"title":"Maximum observed drawdown (%)","description":"Durable peak-to-trough equity drawdown sampled on fresh quotes; not an intratick maximum.","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":16,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_max_drawdown_percent{job=\"automated-trader\"}","legendFormat":"{{pair}}"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]}},
    {"id":7,"title":"Position entry cost / stop / target","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":24,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_position_entry_cost_quote{job=\"automated-trader\"} > 0","legendFormat":"{{pair}} entry cost"},{"refId":"B","expr":"trader_position_stop_price{job=\"automated-trader\"} > 0","legendFormat":"{{pair}} stop"},{"refId":"C","expr":"trader_position_target_price{job=\"automated-trader\"} > 0","legendFormat":"{{pair}} target"}]},
    {"id":8,"title":"Latest model action / evaluation outcome","type":"table","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":24,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_last_model_action{job=\"automated-trader\"}","instant":true,"format":"table"},{"refId":"B","expr":"trader_last_evaluation_outcome{job=\"automated-trader\"}","instant":true,"format":"table"},{"refId":"C","expr":"trader_last_decision_order_accepted{job=\"automated-trader\"}","instant":true,"format":"table"}]},
    {"id":9,"title":"Why no trade / current entry blocker","type":"table","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":32,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_last_no_trade_reason{job=\"automated-trader\"}","instant":true,"format":"table"},{"refId":"B","expr":"trader_entry_block_reason{job=\"automated-trader\"}","instant":true,"format":"table"}]},
    {"id":10,"title":"Latest model latency (seconds)","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":32,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_last_model_latency_seconds{job=\"automated-trader\"}","legendFormat":"{{pair}}"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":11,"title":"PnL by quote currency (never mixed)","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":40,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum by (quote_asset) (trader_net_pnl_quote{job=\"automated-trader\"})","legendFormat":"{{quote_asset}}"}]},
    {"id":12,"title":"UTC daily P&L / loss-limit context","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":40,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_daily_pnl_quote{job=\"automated-trader\"}","legendFormat":"{{pair}} ({{quote_asset}})"}]},
    {"id":13,"title":"Native stop verified / pending order","type":"table","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":48,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_native_stop_active{job=\"automated-trader\"}","instant":true,"format":"table"},{"refId":"B","expr":"trader_pending_order{job=\"automated-trader\"}","instant":true,"format":"table"}]},
    {"id":14,"title":"Tracking began","type":"stat","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":48,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_performance_since_timestamp_seconds{job=\"automated-trader\"} * 1000","legendFormat":"{{pair}}"}],"fieldConfig":{"defaults":{"unit":"dateTimeAsIso"},"overrides":[]}},
    {"id":15,"title":"Exporter fresh / connected feeds","type":"stat","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":56,"w":12,"h":6},"targets":[{"refId":"A","expr":"trader_exporter_up{job=\"automated-trader\"}","legendFormat":"exporter fresh"},{"refId":"B","expr":"count(trader_websocket_connected{job=\"automated-trader\"} == 1)","legendFormat":"connected feeds"}]},
    {"id":16,"title":"No-trade evaluations by reason","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":56,"w":12,"h":6},"targets":[{"refId":"A","expr":"increase(trader_no_trade_total{job=\"automated-trader\"}[10m])","legendFormat":"{{pair}}: {{reason}}"}]}
  ]
}
