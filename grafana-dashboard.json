{
  "__inputs": [{"name":"DS_PROMETHEUS","label":"Prometheus","type":"datasource","pluginId":"prometheus","pluginName":"Prometheus"}],
  "title":"Automated Trader — Spot Testnet",
  "uid":"automated-trader-testnet",
  "schemaVersion":39,
  "version":1,
  "refresh":"5s",
  "time":{"from":"now-1h","to":"now"},
  "tags":["trading","testnet"],
  "panels":[
    {"id":1,"title":"Allocated equity by pair (USDT)","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_equity_quote{job=\"automated-trader\"}","legendFormat":"{{pair}}"}]},
    {"id":2,"title":"Position exposure by pair (USDT)","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_exposure_quote{job=\"automated-trader\"}","legendFormat":"{{pair}}"}]},
    {"id":3,"title":"Ollaya p95 latency (seconds)","type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(trader_ollaya_request_duration_seconds_bucket{job=\"automated-trader\"}[5m])))"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":4,"title":"Errors per second", "type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"rate(trader_errors_total{job=\"automated-trader\"}[5m])","legendFormat":"{{component}}"}]},
    {"id":5,"title":"WebSocket quote age by pair", "type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":16,"w":8,"h":8},"targets":[{"refId":"A","expr":"trader_market_quote_age_seconds{job=\"automated-trader\"}","legendFormat":"{{pair}}"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":6,"title":"Entries enabled (1 = yes)", "type":"stat","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":8,"y":16,"w":8,"h":5},"targets":[{"refId":"A","expr":"min(trader_entries_enabled{job=\"automated-trader\"})","legendFormat":"min"}}]},
    {"id":7,"title":"Exporter up", "type":"stat","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":16,"y":16,"w":8,"h":5},"targets":[{"refId":"A","expr":"trader_exporter_up{job=\"automated-trader\"}"}]},
    {"id":8,"title":"Portfolio equity (USDT)", "type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":0,"y":24,"w":12,"h":8},"targets":[{"refId":"A","expr":"trader_portfolio_equity_quote{job=\"automated-trader\"}"}]},
    {"id":9,"title":"Connected feeds / pairs", "type":"stat","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":12,"y":24,"w":6,"h":8},"targets":[{"refId":"A","expr":"count(trader_websocket_connected{job=\"automated-trader\"} == 1)","legendFormat":"connected"}]},
    {"id":10,"title":"Decisions per second", "type":"timeseries","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"x":18,"y":24,"w":6,"h":8},"targets":[{"refId":"A","expr":"sum(rate(trader_decisions_total{job=\"automated-trader\"}[5m]))","legendFormat":"decisions"}]}
  ]
}
